{
  "name": "faraday",
  "version": "1.0.0",
  "description": "> A self-hostable AI agent for managing Gmail through Discord.",
  "main": "dist/worker.js",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "dev": "npm run dev:worker",
    "dev:worker": "tsx src/worker.ts",
    "dev:server": "tsx src/server.ts",
    "build": "tsc && tsc -p tsconfig.api.json --noEmit",
    "start": "node dist/worker.js",
    "start:server": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdhzarif03/faraday.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mdhzarif03/faraday/issues"
  },
  "homepage": "https://github.com/mdhzarif03/faraday#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "googleapis": "^182.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1"
  },
  "engines": { "node": "24.x" }
}
